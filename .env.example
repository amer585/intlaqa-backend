# ──────────────────────────────────────────────────────────────
# Intlaqa Backend v3 — single PostgreSQL + Redis + Hugging Face
# Copy to ".env" for local dev. All secrets come from the environment ONLY.
# On Hugging Face, set these as Space "Variables" and "Secrets".
# ──────────────────────────────────────────────────────────────

# HTTP — Hugging Face Spaces REQUIRE port 7860
PORT=7860

# Security -----------------------------------------------------
# REQUIRED, strong random string. Generate: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,https://huggingface.co

# Turso / libSQL (single DB) -----------------------------------
# Grades 1-12 + staff all share this one database for now.
DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Upstash Redis (cache-aside layer, optional but recommended) --
# Uses the REST API (POST JSON arrays). Leave blank to disable caching.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_TTL_SEC=300

# Features -----------------------------------------------------
ALLOW_TEST_LOGIN=false
TRUST_PROXY=true
RATE_LIMIT_MAX=300
