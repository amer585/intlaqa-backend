# ──────────────────────────────────────────────────────────────
# Intlaqa Backend v3 — Turso/libSQL (student + teacher DBs) + Upstash Redis + HF Space
# Copy to ".env" for local dev. All secrets come from the environment ONLY.
# On Hugging Face, set these as Space "Variables" and "Secrets".
# ──────────────────────────────────────────────────────────────

# HTTP — Hugging Face Spaces REQUIRE port 7860
PORT=7860

# Security -----------------------------------------------------
# REQUIRED, strong random string. Generate: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,https://huggingface.co

# Turso / libSQL — STUDENT DB (primary/legacy account) ---------
# Students, grades, and staff logins live here.
DATABASE_URL=libsql://your-student-db.turso.io
TURSO_AUTH_TOKEN=your-student-db-turso-auth-token

# Turso / libSQL — TEACHER DB (separate account) ---------------
# Independent Turso account/DB for teacher_accounts + relations.
# Doubles the free limits and isolates teacher data.
# On Hugging Face, set BOTH the URL and TOKEN as Space Secrets.
TEACHER_DATABASE_URL=libsql://your-teacher-db.turso.io
TEACHER_DATABASE_TOKEN=your-teacher-db-turso-auth-token

# Upstash Redis (cache-aside layer, optional but recommended) --
# Uses the REST API (POST JSON arrays). Leave blank to disable caching.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_TTL_SEC=300

# Features -----------------------------------------------------
ALLOW_TEST_LOGIN=false
TRUST_PROXY=true
RATE_LIMIT_MAX=300
